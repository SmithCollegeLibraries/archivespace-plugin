<%# The viewer reads this escaped, explicit page context before enhancing stock markup. %>
<% dv_record = local_assigns[:record] %>
<% dv_record_type = dv_record ? dv_record.class.name.to_s.split('::').last : '' %>
<% dv_has_children = local_assigns.key?(:has_children) ? local_assigns[:has_children] : (defined?(@has_children) && @has_children) %>
<div
  class="dv-page-context"
  data-dv-page-context="true"
  data-record-type="<%= ERB::Util.html_escape(dv_record_type) %>"
  data-has-children="<%= dv_has_children ? 'true' : 'false' %>"
  aria-hidden="true"
></div>

<% if local_assigns[:dig_objs] && dig_objs.present? %>
<div class="available-digital-objects">
  <% dig_objs.each do |d_file| %>
    <% if !d_file['out'].blank? %>
      <a
        class="external-digital-object__link record-type-badge digital_object"
        href="<%= d_file['out'] %>"
        target="new"
        title="<%= t('digital_object._public.link') %>"
      >
        <%= t('digital_object._public.link') %>
      </a>
    <% end %>
  <% end %>
</div>
<% end %>
