<%#
  digital_viewer plugin — override of shared/_digital.html.erb
  Suppresses the representative thumbnail and objectimage divs entirely —
  the inline IIIF viewer replaces them.
  For archival object pages (dig_objs loop), the external links are kept as
  hidden anchors so digital_viewer.js can still detect the file URI.
%>
<% if local_assigns[:dig_objs] && dig_objs.present? %>
<div class="available-digital-objects">
  <% dig_objs.each do |d_file| %>
    <% if !d_file['out'].blank? %>
      <%# Hidden anchor — preserves JS detection of file URI without showing thumbnail UI %>
      <a
        class="external-digital-object__link record-type-badge digital_object"
        href="<%= d_file['out'] %>"
        style="display:none"
        target="new"
        title="<%= t('digital_object._public.link') %>"
      ></a>
    <% end %>
  <% end %>
</div>
<% end %>
<%# representative_file_version thumbnail intentionally suppressed — IIIF viewer renders inline %>
